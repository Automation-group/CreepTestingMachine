# Environment configuration for creep-server logging

# Log format: "text" for human-readable logs, "json" for structured JSON logs
# Use "json" for production environments and log aggregation systems
LOG_FORMAT=text

# Log level: "debug", "info", "warn", "error"
# Use "debug" for development, "info" for production
LOG_LEVEL=info

# Example usage:
# For development:
# LOG_FORMAT=text LOG_LEVEL=debug ./creepserver

# For production with JSON logging:
# LOG_FORMAT=json LOG_LEVEL=info ./creepserver

# For production with log file output:
# LOG_FORMAT=json LOG_LEVEL=info ./creepserver >> /var/log/creep-server.log 2>&1
